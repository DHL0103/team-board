<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.promptech.springboottutorial.mapper.MemberMapper">

    <select id="selectMemberById" resultType="kr.co.promptech.springboottutorial.model.Member">
        SELECT * FROM members WHERE id = #{id}
    </select>

    <select id="findByUsername" resultType="kr.co.promptech.springboottutorial.model.Member">
        SELECT * FROM members WHERE username = #{username}
    </select>

</mapper>
