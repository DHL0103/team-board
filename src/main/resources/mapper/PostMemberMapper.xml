<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.promptech.springboottutorial.mapper.PostMemberMapper">

    <select id="findByPostId" resultType="kr.co.promptech.springboottutorial.model.PostMember">
        SELECT * FROM post_members WHERE post_id = #{postId}
    </select>

    <select id="findAssigneesByPostId" resultType="kr.co.promptech.springboottutorial.model.dto.BoardMemberResponseDto">
        SELECT pm.member_id, m.username
        FROM post_members pm
        JOIN members m ON pm.member_id = m.id
        WHERE pm.post_id = #{postId}
        ORDER BY m.username
    </select>

    <delete id="deleteByPostId">
        DELETE FROM post_members WHERE post_id = #{postId}
    </delete>

    <select id="countByPostIdAndMemberId" resultType="int">
        SELECT COUNT(*) FROM post_members WHERE post_id = #{postId} AND member_id = #{memberId}
    </select>

    <insert id="save">
        INSERT INTO post_members (post_id, member_id) VALUES (#{postId}, #{memberId})
    </insert>

    <delete id="delete">
        DELETE FROM post_members WHERE post_id = #{postId} AND member_id = #{memberId}
    </delete>

</mapper>
